# Local development secrets — copy to .dev.vars (gitignored).
# `bun run dev` loads these into process.env before Vite starts.
# In production, the same keys come from the service environment variables.

# Neon Postgres pooler connection string.
#
# Use a Neon *development branch* pooler URL, not the production compute.
# A long local `bun run dev` session keeps that compute awake and burns
# the project's monthly CU-hour allowance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon Auth — non-secret, but read from the server environment.
NEON_AUTH_BASE_URL="https://ep-lingering-dust-azywq1po.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-lingering-dust-azywq1po.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Mayar billing (Markx Pro, custom QRIS checkout). Use sandbox key locally.
# Feature flag. "true" enables Pro limits + checkout UI.
MAYAR_BILLING_ENABLED=false
MAYAR_API_KEY=
MAYAR_ENV=sandbox
# Pro price in IDR per 30-day period. Optional — defaults to 49000.
# MAYAR_PRO_PRICE_IDR=49000

# Directory for image assets (defaults to ./data/assets).
# MARKX_ASSETS_DIR=./data/assets
